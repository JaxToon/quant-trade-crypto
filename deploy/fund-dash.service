[Unit]
Description=TraderStuff fund dashboard (127.0.0.1:8090)
After=network-online.target
Wants=network-online.target

[Service]
User=trader
WorkingDirectory=/home/trader/TraderStuff
ExecStart=/home/trader/TraderStuff/.venv/bin/python -m fund.dashboard
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
