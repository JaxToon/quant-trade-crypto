[Unit]
Description=TraderStuff fund daemon (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=trader
WorkingDirectory=/home/trader/TraderStuff
ExecStart=/home/trader/TraderStuff/.venv/bin/python -m fund.daemon --mode paper
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
