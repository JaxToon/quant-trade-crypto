# Copy this file to .env and fill in real values. Never commit .env itself.

# Neo4j
# Local/self-hosted:  bolt://localhost:7687
# Neo4j AuraDB (managed cloud, free tier): neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# OpenAI (for LLM multi-agent consensus)
OPENAI_API_KEY=

# Asset Selection
ASSET_TYPE=crypto
MARKET_SOURCE=binance

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# Paper trading (virtual account — no real orders)
PAPER_TRADING_ENABLED=true
PAPER_TRADING_STARTING_BALANCE=10000
